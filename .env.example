# ==============================================================================
# Dental-Apps (PMS/EDR) Environment Variables Template
# Salin file ini ke .env.local dan isi dengan credentials proyek Anda
# ==============================================================================

# Supabase Credentials (Dapatkan dari Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Database Direct Connection (Opsional jika menggunakan migrasi direct Postgres)
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# SATUSEHAT Kemenkes RI API Credentials (Production / Staging)
SATUSEHAT_AUTH_URL=https://api-satusehat-stg.dto.kemkes.go.id/oauth2/v1
SATUSEHAT_BASE_URL=https://api-satusehat-stg.dto.kemkes.go.id/fhir-r4/v1
SATUSEHAT_CLIENT_ID=your_client_id_here
SATUSEHAT_CLIENT_SECRET=your_client_secret_here
SATUSEHAT_ORGANIZATION_ID=your_organization_id_here

# BPJS P-Care Gigi Bridging
BPJS_CONS_ID=your_bpjs_cons_id
BPJS_SECRET_KEY=your_bpjs_secret_key
BPJS_USER_KEY=your_bpjs_user_key
BPJS_PCARE_URL=https://apijkn-dev.bpjs-kesehatan.go.id/pcare-rest-dev
